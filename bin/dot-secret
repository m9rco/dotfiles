#!/usr/bin/env sh
#
# 凭据管理的命令行入口。
#
#   dot-secret set <NAME>      交互式存入系统密钥库（输入不回显）
#   dot-secret get <NAME>      取值并写到 stdout
#   dot-secret has <NAME>      只判断是否存在（用退出码）
#   dot-secret list            列出可用的来源与已知条目的**名字**
#   dot-secret scan            用 gitleaks 扫一遍仓库
#
# 任何子命令都不会把凭据的值写进日志。`get` 会把值写到 stdout ——
# 那是它的用途（`k=$(dot-secret get NAME)`），但请不要把它管道进日志文件。
#
# shellcheck shell=sh

set -u

DOT_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
DOT_LIB_DIR="$DOT_ROOT/lib"
export DOT_LIB_DIR DOT_ROOT

# shellcheck source=lib/log.sh
. "$DOT_LIB_DIR/log.sh"
# shellcheck source=lib/detect.sh
. "$DOT_LIB_DIR/detect.sh"
dot_detect
# shellcheck source=lib/secrets.sh
. "$DOT_LIB_DIR/secrets.sh"

usage() {
    cat <<EOF
Usage: dot-secret <command> [name]

Commands:
  set <NAME>    Store a credential (input is hidden, never echoed)
  get <NAME>    Print a credential to stdout
  has <NAME>    Exit 0 if the credential can be found, non-zero otherwise
  list          Show available sources and the names of known entries
  scan          Scan this repository for committed credentials

Sources are tried in order: environment, system keychain, 1Password CLI,
then $DOT_ENV_LOCAL (mode 600, never tracked by git).

This repository is public — never commit a credential to it.
EOF
}

cmd=${1:-}
name=${2:-}

case $cmd in
    set)
        [ -n "$name" ] || {
            dot_error 'set requires a name'
            exit 2
        }
        dot_secret_set "$name"
        ;;

    get)
        [ -n "$name" ] || {
            dot_error 'get requires a name'
            exit 2
        }
        dot_secret_get "$name"
        ;;

    has)
        [ -n "$name" ] || {
            dot_error 'has requires a name'
            exit 2
        }
        if dot_secret_has "$name"; then
            dot_success "$name is available"
        else
            dot_error "$name is not available"
            exit 1
        fi
        ;;

    list)
        dot_step 'Secret sources'
        case $DOT_OS in
            macos)
                if command -v security >/dev/null 2>&1; then
                    dot_success 'macOS keychain'
                fi
                ;;
            linux)
                # 写成 if/else 而不是 A && B || C —— 后者在 B 失败时也会跑 C，
                # 会同时打印「可用」和「未安装」两条互相矛盾的信息
                if command -v secret-tool >/dev/null 2>&1; then
                    dot_success 'secret-tool (libsecret)'
                else
                    dot_tip 'secret-tool not installed'
                fi
                ;;
        esac

        if command -v op >/dev/null 2>&1; then
            dot_success '1Password CLI'
        else
            dot_tip '1Password CLI not installed'
        fi

        if [ -f "$DOT_ENV_LOCAL" ]; then
            dot_success "$DOT_ENV_LOCAL ($(_dot_secret_mode "$DOT_ENV_LOCAL"))"
            dot_step 'Names in the local env file'
            # 只列名字，绝不列值
            sed -n 's/^[[:space:]]*\([A-Za-z_][A-Za-z0-9_]*\)[[:space:]]*=.*/  \1/p' \
                "$DOT_ENV_LOCAL" 2>/dev/null || true
        else
            dot_tip "$DOT_ENV_LOCAL does not exist yet"
        fi

        dot_step 'Keychain entries'
        if [ "$DOT_OS" = macos ] && command -v security >/dev/null 2>&1; then
            # dump-keychain 需要用户授权且输出很大；只提示怎么查
            dot_tip "list them in Keychain Access, or query one directly:"
            dot_tip "  security find-generic-password -s $DOT_SECRET_SERVICE -a <NAME> -w"
        else
            dot_tip '(no listable keychain on this platform)'
        fi
        ;;

    scan)
        if ! command -v gitleaks >/dev/null 2>&1; then
            dot_error 'gitleaks is not installed'
            dot_tip 'install it, then rerun:  ./bootstrap.sh --only secrets'
            exit 1
        fi
        dot_step 'Scanning the repository for credentials'
        # --redact 保证发现的值不会被打印出来。
        # 命令名在 gitleaks 8.28 前后不同，两代都要支持：
        #   8.28+  gitleaks dir <path>
        #   8.28-  gitleaks detect --source <path>
        # 显式传 --config：gitleaks 只在当前工作目录找 .gitleaks.toml，
        # 从别的目录调用 dot-secret 时豁免规则会失效。
        if gitleaks dir --help >/dev/null 2>&1; then
            set -- dir "$DOT_ROOT"
        else
            set -- detect --source "$DOT_ROOT"
        fi
        if gitleaks "$@" --config "$DOT_ROOT/.gitleaks.toml" \
            --redact --no-banner; then
            dot_success 'no credentials found'
        else
            dot_error 'gitleaks found something — see the findings above (values redacted)'
            exit 1
        fi
        ;;

    '' | -h | --help | help)
        usage
        ;;

    *)
        dot_error "unknown command: $cmd"
        usage
        exit 2
        ;;
esac
